# build output
/bin/
/dist/
/dev/
# Anchored: unanchored, this also matched cmd/pushmails-client/ and kept the
# program's entry point out of the repository entirely.
/pushmails-client
*.exe

# packaging tooling is ours, not the user's: the repository documents building
# from source and wiring up the service by hand
/packaging/linux/
/packaging/windows/
# Linux packages — built into dist/ by `make deb` / `make rpm`, but a manual
# dpkg-buildpackage or rpmbuild run can drop them elsewhere
*.deb
*.ddeb
*.rpm
*.changes
*.buildinfo
/rpmbuild/

# configuration — only .example files are tracked
client.cfg
config.yml
config.yaml
.env
.env.local
*.pem
*.key

# operating system / editor
.DS_Store
.idea
.vscode/
